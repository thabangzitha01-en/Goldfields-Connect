@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - Goldfields Connect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            /* Deep purple background matching your prototype */
            background-color: #2e1a47;
            color: white;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .logo-container {
            background-color: white;
            padding: 20px 40px;
            border-radius: 15px;
            display: inline-block;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

            .logo-container img {
                max-height: 120px;
            }

        .btn-gold {
            background-color: #d4af37;
            color: #2e1a47;
            font-weight: bold;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                background-color: #f1c40f;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <div class="container">
        <!-- Logo inside a white pill/card -->
        <div class="logo-container">
            <img src="~/images/college-logo.png" alt="Goldfields TVET College Logo" />
        </div>

        <h1 class="display-3 fw-bold mb-2">Goldfields Connect</h1>
        <p class="lead fs-3 mb-4" style="color: #d4af37;">College Learning Management System</p>
        <p class="mb-5 text-light opacity-75">Learn &middot; Connect &middot; Achieve</p>

        <a asp-controller="Auth" asp-action="Login" class="btn btn-gold btn-lg px-5 py-3 rounded-pill fs-5">
            Login to Portal &rarr;
        </a>
    </div>
</body>
</html>