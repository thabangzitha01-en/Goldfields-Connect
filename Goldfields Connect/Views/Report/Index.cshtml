@model GoldfieldsConnect.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="card p-4 shadow-sm">
    <h4>Generate Report</h4>
    <form asp-action="ExportToPdf" method="post" class="row mt-3">
        <div class="col-md-4 mb-3">
            <label>Report Type</label>
            <select asp-for="ReportType" class="form-select">
                <option value="StudentList">Student List</option>
                <option value="ExamResults">Exam Results</option>
                <option value="Attendance">Attendance Report</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label>Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label>End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>
        <div class="col-md-12">
            <button type="submit" class="btn btn-danger"><i class="fas fa-file-pdf"></i> Export to PDF</button>
            <button type="submit" asp-action="ExportToExcel" class="btn btn-success"><i class="fas fa-file-excel"></i> Export to Excel</button>
        </div>
    </form>
</div>