@{
    ViewData["Title"] = "System Settings";
}
<div class="card p-4 shadow-sm mt-4">
    <h4>System Settings</h4>
    <p class="text-muted">Configure global application settings.</p>
    <form>
        <div class="mb-3">
            <label class="form-label">College Name</label>
            <input type="text" class="form-control" value="Goldfields TVET College" />
        </div>
        <div class="mb-3">
            <label class="form-label">Current Academic Year</label>
            <input type="text" class="form-control" value="2024" />
        </div>
        <button type="submit" class="btn btn-primary" style="background-color:#2e1a47;">Save Settings</button>
    </form>
</div>