@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row">
    <div class="col-md-12 mb-4">
        <h4>Welcome back, Admin!</h4>
        <p class="text-muted">System overview and management</p>
    </div>

    <!-- Stat Cards -->
    <div class="col-md-3 mb-4">
        <div class="card stat-card p-3 border-start border-4 border-primary">
            <h6 class="text-muted">Total Students</h6>
            <h3 class="fw-bold mb-0">1,250</h3>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card stat-card p-3 border-start border-4 border-warning">
            <h6 class="text-muted">Total Lecturers</h6>
            <h3 class="fw-bold mb-0">150</h3>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card stat-card p-3 border-start border-4 border-success">
            <h6 class="text-muted">Total Courses</h6>
            <h3 class="fw-bold mb-0">75</h3>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card stat-card p-3 border-start border-4 border-info">
            <h6 class="text-muted">Active Users</h6>
            <h3 class="fw-bold mb-0">1,400</h3>
        </div>
    </div>

    <!-- System Health -->
    <div class="col-md-6 mb-4">
        <div class="card stat-card p-3">
            <h5 class="mb-3">System Health</h5>
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle text-success fa-2x me-3"></i>
                <div>
                    <h6 class="mb-0">All systems operational</h6>
                    <small class="text-muted">Last checked: Just now</small>
                </div>
            </div>
        </div>
    </div>
</div>