@model GoldfieldsConnect.ViewModels.CreateLecturerViewModel
@{
    ViewData["Title"] = "Add Lecturer";
}
<div class="card p-4 shadow-sm mt-4">
    <h4>Add New Lecturer</h4>
    <form asp-action="Create" method="post">
        <div class="row">
            <div class="col-md-6 mb-3"><label>First Name</label><input asp-for="FirstName" class="form-control" required /></div>
            <div class="col-md-6 mb-3"><label>Last Name</label><input asp-for="LastName" class="form-control" required /></div>
            <div class="col-md-6 mb-3"><label>Email</label><input asp-for="Email" class="form-control" required /></div>
            <div class="col-md-6 mb-3"><label>Staff Number</label><input asp-for="StaffNumber" class="form-control" required /></div>
            <div class="col-md-12 mb-3">
                <label>Department</label>
                <select asp-for="DepartmentId" asp-items="Model.DepartmentsList" class="form-select"><option value="">-- Select Department --</option></select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="background-color:#2e1a47;">Save Lecturer</button>
    </form>
</div>