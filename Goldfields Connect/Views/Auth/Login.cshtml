@model GoldfieldsConnect.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Goldfields Connect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f4f6f9;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        /* Left Side - Branding */
        .login-left {
            background-color: #2e1a47;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            padding: 40px;
            text-align: center;
        }

            .login-left img {
                max-height: 150px;
                background: white;
                padding: 20px;
                border-radius: 50%; /* Makes the logo circular */
                margin-bottom: 30px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            }

            .login-left h2 {
                color: #d4af37;
                font-weight: bold;
            }

        /* Right Side - Form */
        .login-right {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            background: white;
        }

        .form-container {
            width: 100%;
            max-width: 400px;
            padding: 20px;
        }

        .form-control {
            padding: 12px;
            border-radius: 8px;
        }

        .btn-primary {
            background-color: #2e1a47;
            border-color: #2e1a47;
            padding: 12px;
            border-radius: 8px;
            font-weight: bold;
        }

            .btn-primary:hover {
                background-color: #1a0f29;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- LEFT SIDE: Logo and Branding -->
            <div class="col-md-6 d-none d-md-flex login-left">
                <img src="~/images/college-logo.png" alt="Goldfields Logo" />
                <h2>Goldfields Connect</h2>
                <p class="text-light opacity-75 mt-2">Learn &middot; Connect &middot; Achieve</p>
            </div>

            <!-- RIGHT SIDE: Login Form -->
            <div class="col-md-6 login-right">
                <div class="form-container">
                    <div class="mb-5">
                        <h3 class="fw-bold" style="color: #2e1a47;">Login to Your Account</h3>
                        <p class="text-muted">Enter your credentials to continue</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@college.edu.za" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-muted">Remember me</label>
                            </div>
                            <a href="#" class="text-decoration-none fw-semibold" style="color: #2e1a47;">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">Login</button>

                        <div class="text-center mt-4">
                            <small class="text-muted">Don't have an account? Contact your college administrator.</small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Required for validation scripts to work -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>