@model GoldfieldsConnect.ViewModels.SubjectDetailsViewModel
@{
    ViewData["Title"] = Model.Subject.Name;
}
<div class="card p-4 shadow-sm mt-4">
    <h3>@Model.Subject.Name (@Model.Subject.Code)</h3>
    <p class="text-muted">Credits: @Model.Subject.Credits | Lecturer: @Model.LecturerName</p>

    <hr />
    <h5>Learning Materials</h5>
    <ul>
        @foreach (var mat in Model.Materials)
        {
            <li>@mat.Title</li>
        }
    </ul>
</div>