@model IEnumerable<GoldfieldsConnect.Models.StudentProfile>
@{
    ViewData["Title"] = "Manage Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Manage Students</h4>
    <a asp-action="Create" class="btn btn-primary" style="background-color:#2e1a47;">Add Student</a>
</div>

<div class="card p-3 shadow-sm">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Student Number</th>
                <th>Programme</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentNumber</td>
                    <td>@item.Programme?.Name</td>
                    <td><span class="badge bg-success">@item.Status</span></td>
                    <td><a href="#" class="btn btn-sm btn-outline-primary">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>